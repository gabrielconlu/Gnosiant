# Frontend / Expo web app
EXPO_PUBLIC_APP_NAME=Gnosiant
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api

# API server and local PostgreSQL
PORT=3001
DATABASE_URL=postgres://gnosiant:change-me@localhost:5432/gnosiant
DATABASE_POOL_SIZE=10
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
NODE_ENV=development
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:19006,http://localhost:3000,http://localhost:3001,http://localhost:8081,http://127.0.0.1:19006,http://localhost:8080

# Docker Compose
POSTGRES_DB=gnosiant
POSTGRES_USER=gnosiant
POSTGRES_PASSWORD=replace-with-a-strong-local-password
WEB_PORT=8080
